{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.js",
      "methods": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"]
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "DB_TYPE": "mysql",
    "FRONTEND_URL": "https://www.viladajuda.com.br",
    "DB_HOST": "mysql.viladajuda.com.br",
    "DB_USER": "viladajuda",
    "DB_PASSWORD": "2026dAjudaVila",
    "DB_NAME": "viladajuda",
    "DB_PORT": "3306"
  }
}
